PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
# Encrypts custodial creator signing keys at rest. Generate with: openssl rand -base64 32
SIGNING_KEK=
# Paystack secret key (Spec Music account). sk_test_... for test mode; swap to sk_live_... to go live.
# Also used to verify webhook signatures — no separate webhook secret needed.
PAYSTACK_SECRET_KEY=sk_test_...
